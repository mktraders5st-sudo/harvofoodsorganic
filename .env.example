# Settings template. Real values go in files that are never committed:
#
#   .env.local             your computer, DEVELOPMENT database (used by `npm run dev` and db:* scripts)
#   .env.production.local  your computer, LIVE database (used by db:* scripts with --prod, and `npm start`)
#   Vercel                 Project Settings > Environment Variables (the live website)

# Supabase "Transaction pooler" connection string (Connect > Connection String > Transaction pooler).
# It ends with :6543/postgres and includes your database password. Server-only: never prefix it with NEXT_PUBLIC_.
# DATABASE_URL="postgresql://postgres.<project-id>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Admin password for the LIVE website (12+ characters). Not needed on your own computer:
# `npm run dev` opens /admin without a login on localhost. If unset on a live server, admin stays locked.
# ADMIN_PASSWORD=
