# Settings. Copy to .env.local (never commit .env.local) and fill in what you need.

# Admin password for the LIVE website (12+ characters). Not needed on your own computer:
# `npm run dev` opens /admin without a login on localhost. If unset on a live server, admin stays locked.
# ADMIN_PASSWORD=

# Where the SQLite database lives. Default: ./data/harvo.db
# HARVO_DB_PATH=/var/lib/harvo/harvo.db

# Port for `npm start`. Default: 3000
# PORT=3000
